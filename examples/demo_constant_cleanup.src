/*
  Demo focus:
  - constant folding
  - constant propagation
  - algebraic simplification
  - dead store elimination
  - unreachable loop removal

  Best UI tabs:
  - Optimization Dashboard
  - Optimization Explanations
  - IR Diff
  - summary.txt
*/

int main() {
    int a;
    int b;
    int c;
    int unused;

    a = 2 + 3;
    b = a + 0;
    c = b * 1;

    unused = c + 99;
    unused = unused + 1;

    while (1 < 0) {
        c = c + 50;
    }

    return c;
}
